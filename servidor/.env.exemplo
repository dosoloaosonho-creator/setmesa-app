# Copie para .env e troque os valores. NUNCA suba o .env para o GitHub.

# Senha do painel. Escolha uma longa; é a chave do seu faturamento.
PAINEL_SENHA=troque-esta-senha-agora

# Segredo que assina o cookie da sessão do painel. Qualquer texto longo e aleatório.
SESSAO_SEGREDO=troque-este-segredo-tambem

# Porta interna do container.
PORTA=8080

# Onde fica o banco. No Docker, aponta para o volume.
BANCO=/dados/setmesa-licencas.db

# FASE DE TESTE apenas: abre a porta 8081 para o IP da VPS, sem HTTPS.
# Comente esta linha assim que houver domínio e certificado.
BIND=0.0.0.0

# Rede Docker do proxy que publica o site. Sem isto, o container fica isolado
# e o proxy nao consegue alcancar. Descubra com:
#   docker inspect NOME-DO-PROXY --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
REDE_PROXY=
